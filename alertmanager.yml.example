# alertmanager.yml.example
# Copy to alertmanager.yml on the VPS and fill in real values.
# NEVER commit alertmanager.yml — it contains SMTP credentials.
global:
  smtp_smarthost: 'smtp.example.com:587'  # Set to actual SMTP provider hostname, matching SMTP_HOST in .env
  smtp_from: 'alerts@yourdomain.com'
  smtp_require_tls: true
  smtp_auth_username: 'alertmanager'  # Set to actual SMTP username on VPS
  smtp_auth_password_file: /run/secrets/smtp_alert_password  # Read from Docker secret, not plaintext

route:
  receiver: 'email'
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: 'email'
    email_configs:
      - to: 'admin@yourdomain.com'
