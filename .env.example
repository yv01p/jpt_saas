# .env.example — copy to .env and fill in values
# SECURITY NOTE: Secrets are passed via environment variables. This is acceptable for
# single-operator deployment but should be migrated to Docker secrets before multi-tenant
# production. See security audit: docs/plans/2026-02-26-saas-conversion-phase-1b-security-audit-1.md
DB_URL=jdbc:postgresql://postgres:5432/jpt
DB_USER=jpt
DB_PASS=jpt
DB_NAME=jpt
# Flyway migrations (run from the api container)
FLYWAY_DB_URL=jdbc:postgresql://postgres:5432/jpt
FLYWAY_DB_USER=jpt
FLYWAY_DB_PASS=changeme
# Auth datasource (jpt_auth role, created by V4 migration)
JPT_AUTH_PASSWORD=changeme
COOKIE_SECURE=true
# Share reader role (created by V10 migration)
SHARE_READER_PASSWORD=
WORKER_DB_URL=jdbc:postgresql://postgres:5432/jpt
WORKER_DB_USER=worker_db_user
WORKER_DB_PASS=changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=https://app.example.com
API_TMPFS_SIZE=512m
WORKER_TMPFS_SIZE=1g
MINIO_ACCESS_KEY=changeme       # Root admin credentials — used only by minio and minio-init
MINIO_SECRET_KEY=changeme
# Scoped service accounts provisioned by minio-init on first start
MINIO_API_ACCESS_KEY=changeme-api
MINIO_API_SECRET_KEY=changeme
MINIO_WORKER_ACCESS_KEY=changeme-worker
MINIO_WORKER_SECRET_KEY=changeme
MINIO_BACKUP_ACCESS_KEY=changeme-backup
MINIO_BACKUP_SECRET_KEY=changeme
# MINIO_SERVER_URL=https://app.example.com  # Required for production pre-signed URLs
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=changeme
JWT_SECRET=  # Generate with: openssl rand -base64 64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
B2_ACCESS_KEY=
B2_SECRET_KEY=
B2_BACKUP_ACCESS_KEY=
B2_BACKUP_SECRET_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
